// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

// Use MongoDB as the datasource for this project
datasource db {
  provider = "mongodb"
  // In Prisma v7+, the URL is moved to prisma.config.js
  // For now, we keep it here for v6 compatibility
  url      = env("DATABASE_URL")
}

// Enum for post status
enum PostStatus {
  DRAFT
  SCHEDULED  // Post is scheduled to be published at a specific time
  APPROVED
  PUBLISHED
  DISCARDED
}

// Enum for media type
enum MediaType {
  NONE
  IMAGE
  VIDEO
}

// Enum for image generation type
enum ImageGenerationType {
  AI_GENERATED      // Generated automatically by our system
  AI_PROMPT_USED    // User got prompt and generated elsewhere
  USER_UPLOADED     // User uploaded their own image
}

model User {
  id           String    @id @map("_id") @default(auto()) @db.ObjectId
  email        String    @unique
  name         String?
  image        String?
  linkedInId   String?   @unique
  accessToken  String?   // LinkedIn OAuth access token
  refreshToken String?   // LinkedIn OAuth refresh token
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts        Post[]
  preferences  Preference?
  activities   Activity[]
  media        Media[]
}

model Post {
  id                  String               @id @map("_id") @default(auto()) @db.ObjectId
  userId              String               @db.ObjectId
  user                User                 @relation(fields: [userId], references: [id])
  draftText           String
  finalText           String?
  status              PostStatus           @default(DRAFT)
  linkedInPostId      String?
  
  // Media fields
  mediaType           MediaType            @default(NONE)
  imageUrl            String?              // URL to stored image
  videoUrl            String?              // URL to stored video
  imagePrompt         String?              // AI-generated image prompt for regeneration
  imageGenerationType ImageGenerationType? // How the image was obtained
  
  // Content metadata
  hashtags            String[]             @default([]) // Array of hashtags
  isAIGenerated       Boolean              @default(false) // Track if post was AI-generated
  
  // Scheduling
  scheduledAt         DateTime?            // When the post is scheduled to be published
  createdAt           DateTime             @default(now())
  publishedAt         DateTime?

  analytics           Analytics?
}

model Preference {
  id             String   @id @map("_id") @default(auto()) @db.ObjectId
  userId         String   @db.ObjectId @unique
  user           User     @relation(fields: [userId], references: [id])
  tone           String?
  length         String?
  postingWindows String[]
  blockedTopics  String[]
  createdAt      DateTime @default(now())
}

model Activity {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  source    String
  snippet   String
  timestamp DateTime
}

model Analytics {
  id         String   @id @map("_id") @default(auto()) @db.ObjectId
  postId     String   @db.ObjectId @unique
  post       Post     @relation(fields: [postId], references: [id])
  impressions Int     @default(0)
  likes       Int     @default(0)
  comments    Int     @default(0)
  shares      Int     @default(0)
  fetchedAt   DateTime @default(now())
}

model Media {
  id          String    @id @map("_id") @default(auto()) @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])
  fileName    String
  fileUrl     String    // Public or signed URL from R2
  fileType    String    // MIME type (image/jpeg, video/mp4, etc.)
  fileSize    Int       // Size in bytes
  width       Int?      // For images/videos
  height      Int?      // For images/videos
  duration    Float?    // For videos (in seconds)
  mediaType   MediaType @default(NONE) // 'image' or 'video'
  uploadedAt  DateTime  @default(now())
  expiresAt   DateTime? // Optional: for temporary files
  
  @@index([userId])
  @@index([mediaType])
}
