# Database
DATABASE_URL="mongodb://localhost:27017/postlin"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Google OAuth (for primary authentication)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# LinkedIn OAuth (for posting and connection)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# Encryption (for storing Gemini API keys securely)
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GEMINI_KEYS_ENCRYPTION_KEY="your-base64-encryption-key-here"

# Redis (for background jobs)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Email (optional - for notifications)
RESEND_API_KEY="your-resend-api-key"

# Environment
NODE_ENV="development"
DEBUG="true"
